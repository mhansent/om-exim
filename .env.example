# Copy this file to .env next to config.yaml and fill in the tokens locally.
OM_SOURCE_TOKEN=
OM_TARGET_TOKEN=

# Optional API base URL overrides. Uncomment and edit to override the YAML.
# OM_SOURCE_SERVER_URL=https://om-source.example.com/api
# OM_TARGET_SERVER_URL=https://om-target.example.com/api

# Optional token variable name overrides. Set the token under the chosen name.
# OM_SOURCE_TOKEN_ENV=OM_SOURCE_TOKEN
# OM_TARGET_TOKEN_ENV=OM_TARGET_TOKEN
